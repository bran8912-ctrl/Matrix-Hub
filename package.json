{
  "name": "astro-supabase-starter",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "deploy:testnet:mtx": "hardhat run scripts/deploy_mtx.js --network sepolia",
    "deploy:testnet:casino": "hardhat run scripts/deploy_casino.js --network sepolia",
    "deploy:testnet:distribute": "hardhat run scripts/distribute_mtx.js --network sepolia",
    "deploy:testnet:full": "npm run deploy:testnet:mtx && npm run deploy:testnet:casino && npm run deploy:testnet:distribute",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "./scripts/deploy.sh",
    "compile": "node scripts/compile-wrapper.js",
    "test": "node scripts/test-wrapper.js",
    "deploy:mainnet": "hardhat run scripts/deploy_mtx.js --network mainnet",
    "deploy:sepolia": "hardhat run scripts/deploy_mtx.js --network sepolia",
    "verify:mainnet": "hardhat verify --network mainnet",
    "verify:sepolia": "hardhat verify --network sepolia",
    "content-workflow": "node content-workflow.js",
    "content:scan": "node content-workflow.js scan",
    "content:generate": "node content-workflow.js generate",
    "content:watch": "node content-workflow.js watch",
    "content:analytics": "node content-workflow.js analytics",
    "content:help": "node content-workflow.js help",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:contracts": "solhint 'contracts/**/*.sol'",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.4.2",
    "@supabase/supabase-js": "^2.48.1",
    "@tailwindcss/vite": "^4.0.1",
    "@vitejs/plugin-react": "^5.1.2",
    "astro": "^5.15.9",
    "chokidar": "^4.0.0",
    "ethers": "^6.16.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^7.3.0",
    "web3modal": "^1.9.12"
  },
  "devDependencies": {
    "@astrojs/node": "^9.5.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.4.0",
    "@tailwindcss/typography": "^0.5.16",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^2.3.0",
    "solhint": "^6.0.2",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^4.0.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript-eslint": "^8.51.0"
  }
