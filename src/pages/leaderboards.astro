---
import Layout from "../components/Layout.astro";

export const prerender = true;
title: "Leaderboards";
navCategory: "leaderboards";
---

<Layout title="Leaderboards - Matrix Hub">
  <div class="leaderboards-page">
    <h1 class="page-title">🏆 Matrix Hub Leaderboards</h1>
    <p class="page-description">
      Top players, biggest wins, and community champions
    </p>

    <div class="leaderboards-content">
      <!-- Coming Soon Notice -->
      <div class="info-card coming-soon">
        <div class="icon">🚧</div>
        <h2>Full Leaderboards Coming Soon!</h2>
        <p>
          We're building comprehensive leaderboards to track and reward the best players in the Matrix Hub community.
          Check back soon for live rankings!
        </p>
      </div>

      <!-- Planned Leaderboards -->
      <div class="leaderboard-grid">
        <div class="leaderboard-card">
          <div class="card-header">
            <h2>🎰 Top Casino Players</h2>
          </div>
          <div class="card-body">
            <p>Players ranked by total casino winnings</p>
            <ul class="features">
              <li>Total MTX won</li>
              <li>Biggest single win</li>
              <li>Win streak records</li>
              <li>Games played</li>
            </ul>
          </div>
        </div>

        <div class="leaderboard-card">
          <div class="card-header">
            <h2>💎 Top MTX Holders</h2>
          </div>
          <div class="card-body">
            <p>Largest MTX token holders</p>
            <ul class="features">
              <li>Total MTX balance</li>
              <li>Staking amount</li>
              <li>Token holder rank</li>
              <li>Time holding</li>
            </ul>
          </div>
        </div>

        <div class="leaderboard-card">
          <div class="card-header">
            <h2>🎲 Game Champions</h2>
          </div>
          <div class="card-body">
            <p>Top players by individual games</p>
            <ul class="features">
              <li>Slots high scores</li>
              <li>Blackjack win rates</li>
              <li>Roulette big wins</li>
              <li>Dice streaks</li>
            </ul>
          </div>
        </div>

        <div class="leaderboard-card">
          <div class="card-header">
            <h2>🌟 Community Leaders</h2>
          </div>
          <div class="card-body">
            <p>Most active community members</p>
            <ul class="features">
              <li>Contribution score</li>
              <li>DAO participation</li>
              <li>Proposals submitted</li>
              <li>Community engagement</li>
            </ul>
          </div>
        </div>

        <div class="leaderboard-card">
          <div class="card-header">
            <h2>⚡ Daily/Weekly Challenges</h2>
          </div>
          <div class="card-body">
            <p>Time-limited competition rankings</p>
            <ul class="features">
              <li>Daily challenges</li>
              <li>Weekly tournaments</li>
              <li>Special events</li>
              <li>Seasonal competitions</li>
            </ul>
          </div>
        </div>

        <div class="leaderboard-card">
          <div class="card-header">
            <h2>🎁 Biggest Wins</h2>
          </div>
          <div class="card-body">
            <p>Legendary wins and jackpots</p>
            <ul class="features">
              <li>All-time biggest wins</li>
              <li>Recent big wins</li>
              <li>Multiplier records</li>
              <li>Jackpot history</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Rewards Info -->
      <div class="info-card rewards">
        <h2>🏅 Leaderboard Rewards</h2>
        <p>
          When leaderboards go live, top-ranked players will earn exclusive rewards:
        </p>
        <ul>
          <li><strong>MTX Prizes:</strong> Weekly and monthly prize pools for top players</li>
          <li><strong>NFT Badges:</strong> Unique NFTs for leaderboard champions</li>
          <li><strong>Casino Bonuses:</strong> Free spins and enhanced odds for winners</li>
          <li><strong>VIP Access:</strong> Exclusive features and early access to new games</li>
          <li><strong>Community Recognition:</strong> Hall of fame and profile badges</li>
        </ul>
      </div>

      <!-- Call to Action -->
      <div class="info-card cta">
        <h2>Ready to Compete?</h2>
        <p>
          Start playing casino games and building your MTX portfolio to climb the leaderboards when they launch!
        </p>
        <div class="actions">
          <a href="/games/casino" class="btn-primary">Play Casino Games</a>
          <a href="/buy-mtx" class="btn-secondary">Get MTX Tokens</a>
          <a href="/wallet" class="btn-secondary">Check Your Balance</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .leaderboards-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .page-title {
    font-size: 2.5rem;
    color: var(--theme-primary);
    text-align: center;
    margin-bottom: 1rem;
    text-shadow: 0 0 15px var(--theme-glow);
    font-family: 'Courier New', monospace;
  }

  .page-description {
    text-align: center;
    font-size: 1.1rem;
    color: var(--theme-text);
    margin-bottom: 3rem;
    opacity: 0.9;
  }

  .leaderboards-content {
    display: grid;
    gap: 2rem;
  }

  .info-card {
    padding: 2rem;
    background: rgba(0, 255, 153, 0.05);
    border: 1px solid rgba(0, 255, 153, 0.2);
    border-radius: 8px;
  }

  .info-card.coming-soon {
    text-align: center;
    background: rgba(255, 193, 7, 0.05);
    border-color: rgba(255, 193, 7, 0.3);
  }

  .info-card.rewards {
    background: rgba(147, 51, 234, 0.05);
    border-color: rgba(147, 51, 234, 0.3);
  }

  .info-card.cta {
    text-align: center;
    background: rgba(0, 153, 255, 0.05);
    border-color: rgba(0, 153, 255, 0.3);
  }

  .icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .info-card h2 {
    color: var(--theme-primary);
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', monospace;
  }

  .info-card p {
    color: var(--theme-text);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .info-card ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }

  .info-card li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--theme-text);
  }

  .info-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--theme-primary);
    font-weight: bold;
  }

  .leaderboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .leaderboard-card {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(0, 255, 153, 0.2);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s;
  }

  .leaderboard-card:hover {
    border-color: var(--theme-primary);
    transform: translateY(-4px);
    box-shadow: 0 4px 20px rgba(0, 255, 153, 0.3);
  }

  .card-header {
    background: rgba(0, 255, 153, 0.1);
    padding: 1.5rem;
    border-bottom: 1px solid rgba(0, 255, 153, 0.2);
  }

  .card-header h2 {
    color: var(--theme-primary);
    font-size: 1.3rem;
    margin: 0;
    font-family: 'Courier New', monospace;
  }

  .card-body {
    padding: 1.5rem;
  }

  .card-body p {
    color: var(--theme-text);
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .features {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .features li {
    padding: 0.4rem 0;
    padding-left: 1.3rem;
    position: relative;
    color: var(--theme-text);
    font-size: 0.9rem;
  }

  .features li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--theme-primary);
    font-weight: bold;
  }

  .actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: bold;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--theme-primary);
    color: #181818;
  }

  .btn-secondary {
    background: rgba(0, 255, 153, 0.2);
    color: var(--theme-primary);
    border: 1px solid var(--theme-primary);
  }

  .btn-primary:hover,
  .btn-secondary:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .leaderboards-page {
      padding: 1rem;
    }

    .page-title {
      font-size: 2rem;
    }

    .leaderboard-grid {
      grid-template-columns: 1fr;
    }

    .actions {
      flex-direction: column;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
