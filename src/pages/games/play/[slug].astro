---
import Layout from "../../../components/Layout.astro";
import { games } from "../../../data/games";

export const prerender = true;

export async function getStaticPaths() {
  return games
    .filter((g) => g.playUrl)
    .map((g) => ({
      params: { slug: g.slug },
      props: { game: g },
    }));
}

const { game } = Astro.props;
---

<Layout title={`Play ${game.name} | Matrix Hub`}>
  <div class="play-page">
    <!-- Top bar -->
    <div class="play-bar">
      <a href="/games" class="back-link">← Games</a>
      <div class="game-info">
        <span class="game-title">{game.name}</span>
        <span class="game-tag">{game.tag}</span>
      </div>
      <div class="play-actions">
        <a
          href={game.playUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="fullscreen-btn"
          title="Open in new tab for fullscreen"
        >
          ⤢ Full Tab
        </a>
        {game.gitUrl && !game.playUrl?.startsWith('/') && (
          <a
            href={game.gitUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="source-btn"
          >
            Source ↗
          </a>
        )}
      </div>
    </div>

    <!-- Game iframe -->
    <div class="iframe-wrapper">
      <iframe
        id="game-frame"
        src={game.playUrl}
        title={`Play ${game.name}`}
        allow="fullscreen; accelerometer; gyroscope"
        loading="lazy"
        sandbox="allow-scripts allow-forms allow-pointer-lock allow-popups"
      ></iframe>
      <!-- Fallback shown if iframe fails to load -->
      <div class="iframe-fallback" id="iframe-fallback">
        <p>⚠️ This game can't be embedded due to browser security settings.</p>
        <a
          href={game.playUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="fallback-link"
        >
          ▶ Open {game.name} in a new tab
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .play-page {
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--player-height, 0px) - 4rem);
    min-height: 500px;
  }

  .play-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    background: rgba(0, 0, 0, 0.7);
    border-bottom: 1px solid rgba(34, 197, 94, 0.3);
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .back-link {
    color: rgb(34, 197, 94);
    text-decoration: none;
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: rgb(134, 239, 172);
  }

  .game-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .game-title {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    color: rgb(134, 239, 172);
    font-size: 1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .game-tag {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    color: rgb(107, 114, 128);
    font-style: italic;
  }

  .play-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .fullscreen-btn,
  .source-btn {
    padding: 0.3rem 0.75rem;
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    border-radius: 5px;
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .fullscreen-btn {
    background: rgba(34, 197, 94, 0.15);
    color: rgb(34, 197, 94);
    border: 1px solid rgba(34, 197, 94, 0.4);
  }

  .fullscreen-btn:hover {
    background: rgba(34, 197, 94, 0.3);
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.3);
  }

  .source-btn {
    background: rgba(255, 255, 255, 0.05);
    color: rgb(107, 114, 128);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .source-btn:hover {
    color: rgb(156, 163, 175);
    background: rgba(255, 255, 255, 0.1);
  }

  .iframe-wrapper {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: #000;
  }

  #game-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .iframe-fallback {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.9);
    color: rgb(156, 163, 175);
    font-family: 'Courier New', monospace;
    text-align: center;
    padding: 2rem;
  }

  .fallback-link {
    padding: 0.75rem 1.5rem;
    background: rgba(34, 197, 94, 0.15);
    color: rgb(34, 197, 94);
    border: 1px solid rgba(34, 197, 94, 0.5);
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    transition: background 0.2s;
  }

  .fallback-link:hover {
    background: rgba(34, 197, 94, 0.3);
  }
</style>

<script>
  // Show fallback if the iframe fails to load (e.g., X-Frame-Options block).
  // We wait IFRAME_LOAD_TIMEOUT_MS before assuming the external page refused embedding.
  const IFRAME_LOAD_TIMEOUT_MS = 8000;

  const frame = document.getElementById('game-frame') as HTMLIFrameElement;
  const fallback = document.getElementById('iframe-fallback') as HTMLDivElement;

  if (frame && fallback) {
    let loaded = false;

    frame.addEventListener('load', () => {
      loaded = true;
    });

    // Only apply the timeout for external (cross-origin) URLs.
    const src = frame.src;
    const isExternal = src.startsWith('http');
    if (isExternal) {
      setTimeout(() => {
        if (!loaded) {
          frame.style.display = 'none';
          fallback.style.display = 'flex';
        }
      }, IFRAME_LOAD_TIMEOUT_MS);
    }
  }
</script>
