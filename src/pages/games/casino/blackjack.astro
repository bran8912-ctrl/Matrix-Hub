---
import Layout from "../../../components/Layout.astro";
import CasinoGameWrapper from "../../../components/CasinoGameWrapper";
import BlackjackGame from "../../../casino/blackjack/BlackjackGame";

export const prerender = true;

export const title = "BlackJack";
export const navCategory = "casino";
---

<Layout title="Blackjack - Matrix-Hub Casino">
  <div class="container mx-auto px-4 py-8">
    <CasinoGameWrapper client:only="react">
      {(props: any) => <BlackjackGame {...props} />}
    </CasinoGameWrapper>
  </div>
</Layout>
