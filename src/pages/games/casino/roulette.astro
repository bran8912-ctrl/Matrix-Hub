---
import Layout from "../../../components/Layout.astro";
import CasinoGameWrapper from "../../../components/CasinoGameWrapper";
import RouletteGame from "../../../casino/roulette/RouletteGame";

export const prerender = true;

export const title = "Roulette";
export const navCategory = "casino";
---

<Layout title="Roulette - Matrix-Hub Casino">
  <div class="container mx-auto px-4 py-8">
    <CasinoGameWrapper client:load>
      {(props: any) => <RouletteGame {...props} />}
    </CasinoGameWrapper>
  </div>
</Layout>
