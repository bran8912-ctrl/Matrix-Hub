---
import Layout from "../../../components/Layout.astro";

export const prerender = true;
title: "Crash";
navCategory: "casino";

export const title = "Crash";
export const navCategory = "casino";
---

<Layout title="Crash - Matrix-Hub Casino">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-6 text-center text-green-400">🚀 Crash Game</h1>
    
    <div class="max-w-2xl mx-auto">
      <div class="bg-gray-800 border-2 border-yellow-500 rounded-lg p-8 text-center">
        <div class="text-6xl mb-6">🚧</div>
        <h2 class="text-2xl font-bold text-yellow-400 mb-4">Coming Soon!</h2>
        <p class="text-gray-300 mb-6">
          The Crash game is currently under development. Watch the multiplier grow and cash out before it crashes!
        </p>
        
        <div class="bg-gray-900 border border-green-500 rounded-lg p-6 mb-6">
          <h3 class="text-xl font-bold text-green-400 mb-3">How Crash Works</h3>
          <ul class="text-left space-y-2 text-gray-300">
            <li class="flex items-start">
              <span class="text-green-400 mr-2">►</span>
              <span>Place your MTX bet before the round starts</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-400 mr-2">►</span>
              <span>Watch the multiplier increase from 1.00x</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-400 mr-2">►</span>
              <span>Cash out anytime to win (bet × multiplier)</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-400 mr-2">►</span>
              <span>If the game crashes before you cash out, you lose your bet</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-400 mr-2">►</span>
              <span>Provably fair system ensures transparent results</span>
            </li>
          </ul>
        </div>

        <div class="text-yellow-400 mb-6">
          <p class="font-bold">Expected Features:</p>
          <p class="text-sm">Min 1 MTX bet • Up to 100x multiplier • Live statistics</p>
        </div>

        <a 
          href="/games/casino" 
          class="inline-block bg-green-500 hover:bg-green-600 text-black font-bold py-3 px-6 rounded-lg transition-colors"
        >
          ← Back to Casino
        </a>
      </div>
    </div>
  </div>
</Layout>
