---
import Layout from "../components/Layout.astro";

export const prerender = true;
title: "Staking";
navCategory: "mtx-token";

export const title = "Staking";
export const navCategory = "mtx-token";
---

<Layout title="MTX Staking - Matrix Hub">
  <div class="staking-page">
    <h1 class="page-title">MTX Staking</h1>
    <p class="page-description">
      Stake your MTX tokens to earn rewards and access premium features
    </p>

    <div class="staking-content">
      <div class="info-card coming-soon">
        <div class="icon">🚧</div>
        <h2>Staking Coming Soon!</h2>
        <p>
          MTX staking is currently under development and will be available soon.
          Stake your tokens to earn passive rewards and unlock premium platform benefits.
        </p>
      </div>

      <div class="info-card">
        <h2>Planned Features</h2>
        <ul>
          <li>
            <strong>Flexible Staking:</strong> Stake and unstake anytime without lock periods
          </li>
          <li>
            <strong>Reward Tiers:</strong> Earn higher APY based on staking amount
          </li>
          <li>
            <strong>Premium Access:</strong> Stakers unlock exclusive platform features
          </li>
          <li>
            <strong>Casino Bonuses:</strong> Get enhanced odds and free spins
          </li>
          <li>
            <strong>Governance Rights:</strong> Vote on platform proposals
          </li>
          <li>
            <strong>Early Access:</strong> First access to new games and features
          </li>
        </ul>
      </div>

      <div class="info-card">
        <h2>Staking Tiers (Proposed)</h2>
        <div class="tiers">
          <div class="tier">
            <h3>🥉 Bronze Tier</h3>
            <p class="amount">1,000 - 10,000 MTX</p>
            <ul>
              <li>5% APY</li>
              <li>Basic premium features</li>
              <li>Casino bonus: +2% odds</li>
            </ul>
          </div>

          <div class="tier">
            <h3>🥈 Silver Tier</h3>
            <p class="amount">10,001 - 50,000 MTX</p>
            <ul>
              <li>10% APY</li>
              <li>Advanced features</li>
              <li>Casino bonus: +5% odds</li>
              <li>Governance voting rights</li>
            </ul>
          </div>

          <div class="tier highlighted">
            <h3>🥇 Gold Tier</h3>
            <p class="amount">50,001+ MTX</p>
            <ul>
              <li>15% APY</li>
              <li>All premium features</li>
              <li>Casino bonus: +10% odds</li>
              <li>Priority governance votes</li>
              <li>Early access to new games</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="info-card">
        <h2>How It Will Work</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Connect Wallet</h3>
              <p>Connect your wallet containing MTX tokens</p>
            </div>
          </div>

          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Choose Amount</h3>
              <p>Select how many MTX tokens to stake</p>
            </div>
          </div>

          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Start Earning</h3>
              <p>Earn rewards automatically and unlock benefits</p>
            </div>
          </div>

          <div class="step">
            <div class="step-number">4</div>
            <div class="step-content">
              <h3>Manage Stake</h3>
              <p>Add more, withdraw rewards, or unstake anytime</p>
            </div>
          </div>
        </div>
      </div>

      <div class="info-card newsletter">
        <h2>Stay Updated</h2>
        <p>
          Want to be notified when staking goes live? Join our community channels:
        </p>
        <div class="actions">
          <a href="https://t.me/matrix_hub_official" target="_blank" rel="noopener noreferrer" class="btn-primary">
            Join Telegram
          </a>
          <a href="/wallet" class="btn-secondary">
            Check Your MTX Balance
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .staking-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }

  .page-title {
    font-size: 2.5rem;
    color: var(--theme-primary);
    text-align: center;
    margin-bottom: 1rem;
    text-shadow: 0 0 15px var(--theme-glow);
    font-family: 'Courier New', monospace;
  }

  .page-description {
    text-align: center;
    font-size: 1.1rem;
    color: var(--theme-text);
    margin-bottom: 3rem;
    opacity: 0.9;
  }

  .staking-content {
    display: grid;
    gap: 2rem;
  }

  .info-card {
    padding: 2rem;
    background: rgba(0, 255, 153, 0.05);
    border: 1px solid rgba(0, 255, 153, 0.2);
    border-radius: 8px;
  }

  .info-card.coming-soon {
    text-align: center;
    background: rgba(255, 193, 7, 0.05);
    border-color: rgba(255, 193, 7, 0.3);
  }

  .info-card.newsletter {
    background: rgba(0, 153, 255, 0.05);
    border-color: rgba(0, 153, 255, 0.3);
  }

  .icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .info-card h2 {
    color: var(--theme-primary);
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', monospace;
  }

  .info-card p {
    color: var(--theme-text);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .info-card ul {
    list-style: none;
    padding: 0;
  }

  .info-card li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--theme-text);
  }

  .info-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--theme-primary);
    font-weight: bold;
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .tier {
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(0, 255, 153, 0.2);
    border-radius: 6px;
  }

  .tier.highlighted {
    border-color: var(--theme-primary);
    border-width: 2px;
    background: rgba(0, 255, 153, 0.1);
  }

  .tier h3 {
    color: var(--theme-primary);
    margin-bottom: 0.5rem;
    font-size: 1.2rem;
  }

  .tier .amount {
    font-weight: bold;
    color: var(--theme-text);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .tier ul {
    font-size: 0.9rem;
  }

  .steps {
    display: grid;
    gap: 1.5rem;
  }

  .step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .step-number {
    width: 40px;
    height: 40px;
    background: var(--theme-primary);
    color: #181818;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .step-content h3 {
    color: var(--theme-primary);
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .step-content p {
    color: var(--theme-text);
    margin: 0;
  }

  .actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: bold;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--theme-primary);
    color: #181818;
  }

  .btn-secondary {
    background: rgba(0, 255, 153, 0.2);
    color: var(--theme-primary);
    border: 1px solid var(--theme-primary);
  }

  .btn-primary:hover,
  .btn-secondary:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .staking-page {
      padding: 1rem;
    }

    .page-title {
      font-size: 2rem;
    }

    .tiers {
      grid-template-columns: 1fr;
    }

    .actions {
      flex-direction: column;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
