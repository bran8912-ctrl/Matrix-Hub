---
import Layout from "../../components/Layout.astro";

export const prerender = true;

export const title = "Useful Tools";
export const navCategory = "useful-tools";

// ── Financial & Swarm Intelligence Tools ─────────────────────────────────────
const TOOLS = [
  // ── Swarm-Intelligence / AI Agent Finance ─────────────────────────────────
  {
    category: "swarm-ai",
    label: "SWARM AI ENGINE",
    emoji: "🐝",
    title: "MiroFish",
    description:
      "Open-source universal swarm intelligence engine for prediction and analysis. Spawns thousands of autonomous AI agents that simulate collective behavior to produce prediction reports for finance, markets, politics, and more. Knowledge-graph extraction, multi-agent simulation, and configurable agent personalities.",
    github: "https://github.com/666ghj/MiroFish",
    stars: "★ Trending",
    badge: "SWARM AI",
    badgeColor: "#00ff99",
    tags: ["swarm", "prediction", "finance", "multi-agent"],
  },
  {
    category: "swarm-ai",
    label: "AUTO HEDGE FUND",
    emoji: "🤖",
    title: "AutoHedge",
    description:
      "Autonomous AI hedge fund powered by swarm intelligence. Multiple specialized agents handle trading strategies, technical analysis, statistical modeling, risk management, and live execution. JSON-based institutional-grade output with modular agent design.",
    github: "https://github.com/The-Swarm-Corporation/AutoHedge",
    stars: "The-Swarm-Corporation",
    badge: "AUTONOMOUS",
    badgeColor: "#bf00ff",
    tags: ["hedge-fund", "trading", "swarm", "automation"],
  },
  {
    category: "portfolio",
    label: "PORTFOLIO RISK",
    emoji: "📊",
    title: "Volara",
    description:
      "Open-source portfolio risk management and analysis system built with real-time data processing and advanced ML models. Risk assessment for stocks, derivatives, and bonds; real-time updates; extensible risk metrics; portfolio optimization; and API integration.",
    github: "https://github.com/The-Swarm-Corporation/Volara",
    stars: "The-Swarm-Corporation",
    badge: "RISK MGMT",
    badgeColor: "#00aaff",
    tags: ["portfolio", "risk", "ML", "real-time"],
  },
  {
    category: "swarm-ai",
    label: "CURATED AGENTS",
    emoji: "📋",
    title: "Awesome Financial Agents",
    description:
      "Curated GitHub list of agent-based frameworks and tools focused on financial analysis and trading. Covers frameworks like Tickr Agent and open-aladdin, specialised crypto and stock analysis agents, and step-by-step guides for building multi-agent financial systems.",
    github: "https://github.com/The-Swarm-Corporation/awesome-financial-agents",
    stars: "The-Swarm-Corporation",
    badge: "CURATED LIST",
    badgeColor: "#FFD700",
    tags: ["agents", "finance", "curated", "frameworks"],
  },

  // ── Portfolio Optimisation ─────────────────────────────────────────────────
  {
    category: "portfolio",
    label: "PORTFOLIO OPT",
    emoji: "⚖️",
    title: "PyPortfolioOpt",
    description:
      "Python library for financial portfolio optimization. Implements classical mean-variance optimization, Black-Litterman allocation, risk models (sample covariance, Ledoit-Wolf, semi-covariance), and efficient frontier generation. Battle-tested and widely used.",
    github: "https://github.com/robertmartin8/PyPortfolioOpt",
    stars: "★ 4k+",
    badge: "OPEN SOURCE",
    badgeColor: "#00ff99",
    tags: ["python", "portfolio", "optimization", "quant"],
  },
  {
    category: "analysis",
    label: "FINANCIAL TOOLKIT",
    emoji: "🔧",
    title: "FinanceToolkit",
    description:
      "Comprehensive open-source financial analysis toolkit. Covers 150+ financial ratios and performance measurements including fundamental analysis, technical indicators, risk metrics, and factor analysis. Works with any stock or asset.",
    github: "https://github.com/JerBouma/FinanceToolkit",
    stars: "★ 3.5k+",
    badge: "150+ METRICS",
    badgeColor: "#00aaff",
    tags: ["toolkit", "analysis", "ratios", "technicals"],
  },

  // ── Market Data & Crypto ───────────────────────────────────────────────────
  {
    category: "crypto",
    label: "CRYPTO ANALYSIS",
    emoji: "₿",
    title: "Freqtrade",
    description:
      "Free and open-source crypto trading bot written in Python. Supports backtesting, plotting, machine learning optimization, and paper and live trading on major exchanges. Strategy-first design — write your own logic or use community strategies.",
    github: "https://github.com/freqtrade/freqtrade",
    stars: "★ 33k+",
    badge: "TRADING BOT",
    badgeColor: "#FFD700",
    tags: ["crypto", "bot", "backtesting", "python"],
  },
  {
    category: "analysis",
    label: "QUANT RESEARCH",
    emoji: "📈",
    title: "QuantLib",
    description:
      "Industry-standard quantitative finance library. Pricing of bonds, options, swaps, interest-rate models, yield curves, and Monte Carlo simulations. Used by banks, hedge funds, and quant researchers worldwide. Available in Python, C++, and more.",
    github: "https://github.com/lballabio/QuantLib",
    stars: "★ 5k+",
    badge: "INDUSTRY STD",
    badgeColor: "#ff6600",
    tags: ["quant", "pricing", "bonds", "options"],
  },
  {
    category: "analysis",
    label: "AWESOME LIST",
    emoji: "📚",
    title: "Awesome Quant",
    description:
      "The definitive curated list of quantitative finance resources on GitHub. Libraries, data sources, research papers, books, and tutorials covering algorithmic trading, risk management, portfolio theory, market microstructure, and more.",
    github: "https://github.com/wilsonfreitas/awesome-quant",
    stars: "★ 17k+",
    badge: "RESOURCE HUB",
    badgeColor: "#bf00ff",
    tags: ["curated", "quant", "resources", "trading"],
  },
];

// Build category filter list
const CATEGORIES = [
  { key: "all",       label: "⚡ ALL TOOLS",           count: TOOLS.length },
  { key: "swarm-ai",  label: "🐝 Swarm AI",            count: TOOLS.filter(t => t.category === "swarm-ai").length },
  { key: "portfolio", label: "⚖️ Portfolio",            count: TOOLS.filter(t => t.category === "portfolio").length },
  { key: "analysis",  label: "📈 Analysis",             count: TOOLS.filter(t => t.category === "analysis").length },
  { key: "crypto",    label: "₿ Crypto",               count: TOOLS.filter(t => t.category === "crypto").length },
];
---

<Layout title="Useful Tools — Matrix Hub">
  <div class="tools-page">

    <!-- ── Page Header ──────────────────────────────────────────────────── -->
    <div class="page-header">
      <div class="header-badge">FINANCIAL TOOLS</div>
      <h1 class="page-title">USEFUL TOOLS</h1>
      <p class="page-subtitle">
        Live market charts and financial analysis tools — usable right here on Matrix Hub.<br />
        Plus a curated directory of open-source swarm-intelligence frameworks to self-host.
      </p>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════
         SECTION 1 — LIVE INTERACTIVE TOOLS (embedded, usable on this page)
         ═══════════════════════════════════════════════════════════════════ -->
    <section class="live-section">
      <h2 class="section-heading">
        <span class="section-dot"></span> Live Tools — Use Right Here
      </h2>
      <p class="section-desc">
        These tools are embedded directly on this page — no install, no sign-up required.
      </p>

      <!-- ── Tool 1: TradingView Advanced Chart ─────────────────────────── -->
      <div class="live-tool-card">
        <div class="live-tool-header">
          <span class="live-emoji">📈</span>
          <div>
            <h3 class="live-tool-title">Live Market Chart</h3>
            <p class="live-tool-desc">
              Real-time interactive chart for any stock, crypto, forex, or index.
              Switch symbols, timeframes, drawing tools, indicators — fully featured TradingView chart embedded here.
            </p>
          </div>
          <span class="live-badge">LIVE</span>
        </div>

        <!-- Symbol selector -->
        <div class="symbol-row">
          <span class="symbol-label">Quick switch:</span>
          {[
            { sym: "BINANCE:BTCUSDT",  label: "BTC/USDT" },
            { sym: "BINANCE:ETHUSDT",  label: "ETH/USDT" },
            { sym: "NASDAQ:AAPL",      label: "AAPL" },
            { sym: "NASDAQ:NVDA",      label: "NVDA" },
            { sym: "FOREXCOM:SPXUSD",  label: "S&P 500" },
          ].map((s) => (
            <button class="sym-btn" data-sym={s.sym} type="button">{s.label}</button>
          ))}
        </div>

        <!-- TradingView Advanced Chart container -->
        <div class="tv-chart-wrap">
          <div id="tv-advanced-chart"></div>
        </div>
      </div>

      <!-- ── Tool 2: TradingView Crypto Screener ────────────────────────── -->
      <div class="live-tool-card" style="margin-top:1.5rem;">
        <div class="live-tool-header">
          <span class="live-emoji">🔍</span>
          <div>
            <h3 class="live-tool-title">Crypto Market Screener</h3>
            <p class="live-tool-desc">
              Scan the entire crypto market by price change, volume, market cap, RSI, and more — live data, updated every few seconds.
            </p>
          </div>
          <span class="live-badge">LIVE</span>
        </div>
        <div class="tv-chart-wrap tv-chart-wrap--screener">
          <div class="tradingview-widget-container__widget" id="tv-screener"></div>
        </div>
      </div>

      <!-- ── Tool 3: TradingView Ticker Tape ───────────────────────────── -->
      <div class="live-tool-card" style="margin-top:1.5rem;">
        <div class="live-tool-header">
          <span class="live-emoji">📡</span>
          <div>
            <h3 class="live-tool-title">Market Ticker Tape</h3>
            <p class="live-tool-desc">
              Live scrolling ticker showing real-time prices and daily change for top crypto assets.
            </p>
          </div>
          <span class="live-badge">LIVE</span>
        </div>
        <div class="tv-ticker-wrap">
          <div id="tv-ticker"></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         SECTION 2 — OPEN SOURCE GITHUB TOOLS (self-host / developer resources)
         ═══════════════════════════════════════════════════════════════════ -->
    <section class="github-section">
      <h2 class="section-heading">
        <span class="section-dot section-dot--purple"></span> Open-Source Developer Resources
      </h2>
      <p class="section-desc">
        These are GitHub projects you can clone, run locally, or deploy on your own server.
        They are powerful swarm-AI and quant-finance libraries — not browser embeds, but freely available to build with.
      </p>

      <!-- ── Category Filter Tabs ────────────────────────────────────────── -->
      <nav class="filter-nav" id="filter-nav" aria-label="Tool categories">
        {CATEGORIES.map((cat) => (
          <button
            class={`filter-btn ${cat.key === "all" ? "active" : ""}`}
            data-category={cat.key}
            type="button"
          >
            {cat.label}
            <span class="filter-count">{cat.count}</span>
          </button>
        ))}
      </nav>

      <!-- ── Tools Grid ──────────────────────────────────────────────────── -->
      <div class="tools-grid" id="tools-grid">
        {TOOLS.map((tool) => (
          <article class="tool-card" data-category={tool.category}>
            <div class="tool-top">
              <span class="tool-category-tag">{tool.label}</span>
              <span
                class="tool-badge"
                style={`background: ${tool.badgeColor}20; color: ${tool.badgeColor}; border-color: ${tool.badgeColor}50;`}
              >
                {tool.badge}
              </span>
            </div>

            <div class="tool-title-row">
              <span class="tool-emoji" aria-hidden="true">{tool.emoji}</span>
              <h3 class="tool-title">{tool.title}</h3>
            </div>

            <p class="tool-description">{tool.description}</p>

            <div class="tool-tags">
              {tool.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>

            <div class="tool-meta">
              <span class="tool-stars">{tool.stars}</span>
            </div>

            <a
              href={tool.github}
              target="_blank"
              rel="noopener noreferrer"
              class="tool-cta"
              aria-label={`View ${tool.title} on GitHub`}
            >
              VIEW ON GITHUB
              <span class="cta-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <!-- ── No results fallback ────────────────────────────────────────── -->
      <div class="no-results" id="no-results" style="display:none;">
        <span>🔍</span>
        <p>No tools in this category yet.</p>
      </div>
    </section>

    <!-- ── About Swarm Intelligence Banner ──────────────────────────────── -->
    <div class="about-banner panel">
      <h2 class="about-title">🐝 What is Swarm Intelligence for Finance?</h2>
      <p class="about-desc">
        Swarm intelligence applies collective behavior principles — borrowed from ant colonies, bird flocking, and bee swarms —
        to financial analysis. Multiple autonomous AI agents each analyze different facets of a market (fundamentals, sentiment,
        technical indicators, on-chain data) and their combined output produces more accurate predictions than any single model.
        Tools like <strong>MiroFish</strong> and <strong>AutoHedge</strong> bring this approach to open-source finance.
      </p>
      <div class="about-links">
        <a
          href="https://github.com/topics/swarm-intelligence"
          target="_blank"
          rel="noopener noreferrer"
          class="about-btn"
        >
          🔍 Explore GitHub Topic
        </a>
        <a
          href="https://github.com/The-Swarm-Corporation/awesome-financial-agents"
          target="_blank"
          rel="noopener noreferrer"
          class="about-btn"
        >
          📋 Full Agents List
        </a>
      </div>
    </div>

  </div>
</Layout>

<!-- ── TradingView + category filter (non-blocking) ──────────────────────────── -->
<script is:inline>
(function () {
  var DEFAULT_SYM = 'BINANCE:BTCUSDT';
  var FALLBACK_MSG = 'TradingView chart could not be loaded. ' +
    'Please check your network connection or disable ad blockers.';

  /* ── Advanced Chart (requires tv.js — called from onload) ──────────── */
  function buildChart(sym) {
    var el = document.getElementById('tv-advanced-chart');
    if (!el) return;
    el.innerHTML = '';
    if (!window.TradingView || typeof window.TradingView.widget !== 'function') {
      el.textContent = FALLBACK_MSG;
      return;
    }
    try {
      /* eslint-disable no-new */
      new window.TradingView.widget({
        container_id:        'tv-advanced-chart',
        symbol:              sym || DEFAULT_SYM,
        interval:            '60',
        timezone:            'Etc/UTC',
        theme:               'dark',
        style:               '1',
        locale:              'en',
        width:               '100%',
        height:              520,
        toolbar_bg:          '#0a0f0a',
        enable_publishing:   false,
        allow_symbol_change: true,
        hide_side_toolbar:   false,
        withdateranges:      true,
        save_image:          false,
      });
    } catch (e) {
      console.error('Failed to initialize TradingView widget:', e);
      var el2 = document.getElementById('tv-advanced-chart');
      if (el2) el2.textContent = FALLBACK_MSG;
    }
  }

  /* ── Load tv.js asynchronously; build chart in onload ──────────────── */
  var tvScript = document.createElement('script');
  tvScript.src = 'https://s3.tradingview.com/tv.js';
  tvScript.async = true;
  tvScript.onload = function () { buildChart(DEFAULT_SYM); };
  tvScript.onerror = function () {
    var el = document.getElementById('tv-advanced-chart');
    if (el) el.textContent = FALLBACK_MSG;
  };
  document.head.appendChild(tvScript);

  /* ── Symbol quick-switch buttons (delegate; chart init is async) ───── */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.sym-btn');
    if (!btn) return;
    document.querySelectorAll('.sym-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    buildChart(btn.dataset.sym);
  });

  /* ── Crypto Screener (self-loading embed — no tv.js dependency) ─────── */
  (function () {
    var screenerEl = document.getElementById('tv-screener');
    if (!screenerEl) return;
    var s = document.createElement('script');
    s.type = 'text/javascript';
    s.async = true;
    s.src = 'https://s3.tradingview.com/external-embedding/embed-widget-screener.js';
    s.innerHTML = JSON.stringify({
      width: '100%', height: 490,
      defaultColumn: 'overview', defaultScreen: 'general',
      market: 'crypto', showToolbar: true,
      colorTheme: 'dark', locale: 'en',
    });
    screenerEl.appendChild(s);
  })();

  /* ── Ticker Tape (self-loading embed — no tv.js dependency) ─────────── */
  (function () {
    var tickerEl = document.getElementById('tv-ticker');
    if (!tickerEl) return;
    var s = document.createElement('script');
    s.type = 'text/javascript';
    s.async = true;
    s.src = 'https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
    s.innerHTML = JSON.stringify({
      symbols: [
        { proName: 'BINANCE:BTCUSDT',  title: 'Bitcoin' },
        { proName: 'BINANCE:ETHUSDT',  title: 'Ethereum' },
        { proName: 'BINANCE:SOLUSDT',  title: 'Solana' },
        { proName: 'BINANCE:BNBUSDT',  title: 'BNB' },
        { proName: 'BINANCE:ADAUSDT',  title: 'Cardano' },
        { proName: 'BINANCE:XRPUSDT',  title: 'XRP' },
        { proName: 'BINANCE:DOGEUSDT', title: 'Dogecoin' },
        { proName: 'FOREXCOM:SPXUSD',  title: 'S&P 500' },
        { proName: 'NASDAQ:AAPL',      title: 'Apple' },
        { proName: 'NASDAQ:NVDA',      title: 'NVIDIA' },
      ],
      showSymbolLogo: true, colorTheme: 'dark',
      isTransparent: true, displayMode: 'adaptive', locale: 'en',
    });
    tickerEl.appendChild(s);
  })();

  /* ── GitHub tools category filter (no tv.js dependency) ────────────── */
  (function () {
    var grid      = document.getElementById('tools-grid');
    var noResults = document.getElementById('no-results');
    var filterNav = document.getElementById('filter-nav');
    if (!grid || !noResults || !filterNav) return;
    filterNav.addEventListener('click', function (e) {
      var btn = e.target.closest('.filter-btn');
      if (!btn) return;
      var cat = btn.dataset.category;
      filterNav.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var visible = 0;
      grid.querySelectorAll('.tool-card').forEach(function (card) {
        var matches = cat === 'all' || card.dataset.category === cat;
        card.style.display = matches ? '' : 'none';
        if (matches) visible++;
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
    });
  })();
})();
</script>

<style>
  /* ── Page layout ──────────────────────────────────────────────────────── */
  .tools-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    font-family: 'Courier New', monospace;
  }

  /* ── Header ──────────────────────────────────────────────────────────── */
  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .header-badge {
    display: inline-block;
    padding: 0.25rem 1rem;
    font-size: 0.7rem;
    letter-spacing: 3px;
    color: var(--theme-primary);
    border: 1px solid var(--theme-primary);
    border-radius: 20px;
    margin-bottom: 1rem;
    text-transform: uppercase;
    box-shadow: 0 0 10px var(--theme-glow);
  }

  .page-title {
    font-size: 2.8rem;
    color: var(--theme-primary);
    text-shadow: 0 0 20px var(--theme-glow), 0 0 40px var(--theme-glow);
    letter-spacing: 5px;
    margin-bottom: 0.75rem;
    animation: titlePulse 3s ease-in-out infinite alternate;
  }

  @keyframes titlePulse {
    from { text-shadow: 0 0 10px var(--theme-glow), 0 0 20px var(--theme-glow); }
    to   { text-shadow: 0 0 20px var(--theme-glow), 0 0 50px var(--theme-glow), 0 0 80px var(--theme-glow); }
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--theme-text);
    opacity: 0.8;
    line-height: 1.7;
    max-width: 660px;
    margin: 0 auto 1.2rem;
  }

  /* ── Section headings ─────────────────────────────────────────────────── */
  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    color: var(--theme-primary);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
    text-shadow: 0 0 8px var(--theme-glow);
  }

  .section-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--theme-primary);
    box-shadow: 0 0 6px var(--theme-glow);
    flex-shrink: 0;
  }

  .section-dot--purple { background: #bf00ff; box-shadow: 0 0 6px #bf00ff; }

  .section-desc {
    font-size: 0.82rem;
    color: var(--theme-text);
    opacity: 0.65;
    margin-bottom: 1.2rem;
    line-height: 1.6;
  }

  /* ── Live section ─────────────────────────────────────────────────────── */
  .live-section {
    margin-bottom: 3rem;
  }

  .live-tool-card {
    background: var(--theme-bg-panel);
    border: 1px solid var(--theme-border);
    border-radius: 8px;
    padding: 1.4rem;
    transition: border-color 0.2s ease;
  }

  .live-tool-card:hover { border-color: var(--theme-primary); }

  .live-tool-header {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .live-emoji { font-size: 1.8rem; flex-shrink: 0; }

  .live-tool-header > div { flex: 1; min-width: 0; }

  .live-tool-title {
    font-size: 1.1rem;
    color: var(--theme-primary);
    font-weight: bold;
    letter-spacing: 1px;
    margin: 0 0 0.3rem;
    text-shadow: 0 0 8px var(--theme-glow);
  }

  .live-tool-desc {
    font-size: 0.82rem;
    color: var(--theme-text);
    opacity: 0.75;
    line-height: 1.55;
    margin: 0;
  }

  .live-badge {
    font-size: 0.6rem;
    font-weight: bold;
    letter-spacing: 2px;
    padding: 0.2rem 0.65rem;
    border: 1px solid #00ff99;
    border-radius: 4px;
    color: #00ff99;
    background: rgba(0, 255, 153, 0.1);
    flex-shrink: 0;
    animation: livePulse 1.5s ease-in-out infinite alternate;
  }

  @keyframes livePulse {
    from { box-shadow: 0 0 4px #00ff99; }
    to   { box-shadow: 0 0 12px #00ff99; }
  }

  /* ── Symbol quick-switch row ──────────────────────────────────────────── */
  .symbol-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .symbol-label {
    font-size: 0.7rem;
    color: var(--theme-text);
    opacity: 0.5;
    letter-spacing: 1px;
    margin-right: 0.2rem;
  }

  .sym-btn {
    padding: 0.25rem 0.75rem;
    font-size: 0.72rem;
    font-family: 'Courier New', monospace;
    background: transparent;
    border: 1px solid var(--theme-border);
    border-radius: 15px;
    color: var(--theme-text);
    cursor: pointer;
    opacity: 0.7;
    transition: all 0.18s ease;
  }

  .sym-btn:hover,
  .sym-btn.active {
    background: var(--theme-primary);
    border-color: var(--theme-primary);
    color: #000;
    opacity: 1;
    box-shadow: 0 0 8px var(--theme-glow);
  }

  /* ── TradingView chart containers ─────────────────────────────────────── */
  .tv-chart-wrap {
    border-radius: 6px;
    overflow: hidden;
    background: #0a0f0a;
  }

