---
/**
 * OracleBot - The Matrix Oracle Character Avatar
 * 
 * Vanilla JavaScript implementation for maximum compatibility.
 * Uses shared utilities from oracle-utils.ts for security detection and responses.
 * 
 * Features:
 * - Matrix Oracle persona with circular avatar
 * - Security filtering (wallet addresses, private keys, phishing detection)
 * - Voice features with sage-like Oracle voice
 * - Quick actions and apps integration
 * - /report command for security concerns
 * - Responsive and accessible design
 */
import "../styles/oracle-bot-matrix.css";
---

<!-- Oracle Bot Floating Button -->
<div id="matrixBotButton" role="button" aria-label="Open Oracle chat" title="Ask the Oracle">
  ◉
</div>

<!-- Oracle Bot Window Container (managed by vanilla JS for compatibility) -->
<div id="matrixBotWindow">
  <div id="matrixBotHeader">
    <div class="oracle-header__title">THE ORACLE</div>
    <div class="oracle-header__controls">
      <button id="oracleAppsBtn" class="oracle-header__btn" type="button" title="Apps" aria-expanded="false" aria-controls="oracleAppsPanel">APPS</button>
      <button id="oracleVoiceBtn" class="oracle-header__btn" type="button" aria-pressed="false" title="Voice">VOICE</button>
      <select id="oracleVoiceSelect" title="Choose Oracle Voice" aria-label="Voice selection">
        <option value="">Default Voice</option>
      </select>
      <button id="oracleCloseBtn" class="oracle-header__btn" type="button" title="Close">×</button>
    </div>
  </div>

  <div id="oracleQuickActions"></div>
  <div id="oracleAppsPanel" hidden aria-labelledby="oracleAppsBtn"></div>
  <div id="matrixBotMessages"></div>

  <div id="matrixBotInputArea">
    <input id="matrixBotInput" type="text" placeholder="Ask the Oracle..." aria-label="Message input">
    <button id="matrixBotSend" type="button" aria-label="Send message">➤</button>
  </div>
</div>

<!-- Toast Notification Container -->
<div id="oracleMatrixToasts" role="status" aria-live="polite"></div>

<!-- Enhanced Oracle Bot Script with Security Awareness -->
<script>
  // Import shared utilities  
  import {
    GITHUB_REPO_URL,
    detectSecurityIssues,
    getSecurityWarning,
    generateOracleResponse,
    getOracleVoice,
    prefersReducedMotion
  } from '../utils/oracle-utils.ts';

  // Initialize Oracle Bot
  function initOracleBot() {
    const botBtn = document.getElementById('matrixBotButton');
    const botWin = document.getElementById('matrixBotWindow');
    const sendBtn = document.getElementById('matrixBotSend');
    const input = document.getElementById('matrixBotInput');
    const messages = document.getElementById('matrixBotMessages');
    const appsBtn = document.getElementById('oracleAppsBtn');
    const voiceBtn = document.getElementById('oracleVoiceBtn');
    const closeBtn = document.getElementById('oracleCloseBtn');
    const quick = document.getElementById('oracleQuickActions');
    const appsPanel = document.getElementById('oracleAppsPanel');
    const voiceSelect = document.getElementById('oracleVoiceSelect');

    // Check for required elements with helpful error messages
    const missingRequiredElements = [];
    if (!botBtn) missingRequiredElements.push('matrixBotButton');
    if (!botWin) missingRequiredElements.push('matrixBotWindow');
    if (!sendBtn) missingRequiredElements.push('matrixBotSend');
    if (!input) missingRequiredElements.push('matrixBotInput');
    if (!messages) missingRequiredElements.push('matrixBotMessages');

    if (missingRequiredElements.length > 0) {
      console.error(
        '[OracleBot] Failed to initialize: required DOM elements not found:',
        missingRequiredElements
      );
      return;
    }

    let conversation = [];
    let voiceEnabled = false;

    // Build quick action chips
    const quickActions = [
      { label: 'What is MTX?', value: 'what is mtx' },
      { label: 'Security Tips', value: 'security tips' },
      { label: 'About Casino', value: 'tell me about the casino' },
      { label: 'Help', value: '/help' },
    ];

    quickActions.forEach(action => {
      const chip = document.createElement('button');
      chip.className = 'oracle-chip';
      chip.textContent = action.label;
      chip.onclick = () => {
        input.value = action.value;
        sendMessage();
      };
      quick?.appendChild(chip);
    });

    // Populate voice options
    function populateVoices() {
      const voices = window.speechSynthesis?.getVoices() || [];
      if (voiceSelect && voices.length > 0) {
        voiceSelect.innerHTML = '<option value="">Default Voice</option>';
        voices.forEach(voice => {
          if (/en/i.test(voice.lang)) {
            const option = document.createElement('option');
            option.value = voice.voiceURI;
            option.textContent = `${voice.name}`;
            voiceSelect.appendChild(option);
          }
        });
      }
    }

    if (window.speechSynthesis) {
      window.speechSynthesis.addEventListener('voiceschanged', populateVoices);
      populateVoices();
    }

    // Speak message with Oracle voice - only if not already speaking
    function speakMessage(text) {
      if (!voiceEnabled || !window.speechSynthesis) return;
      
      // Only speak if not currently speaking to avoid interrupting messages
      if (window.speechSynthesis.speaking) return;
      
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = 0.85;
      utterance.pitch = 0.7;
      utterance.volume = 0.95;
      
      const voices = window.speechSynthesis.getVoices();
      const selectedVoiceURI = voiceSelect?.value;
      
      let voice = null;
      if (selectedVoiceURI) {
        voice = voices.find(v => v.voiceURI === selectedVoiceURI);
      }
      
      // Fallback to Oracle voice utility function
      if (!voice) {
        voice = getOracleVoice();
      }
      
      if (voice) utterance.voice = voice;
      window.speechSynthesis.speak(utterance);
    }

    // Create message element
    function createMessage(role, content, isSecurityWarning = false) {
      const div = document.createElement('div');
      div.className = `bot-msg bot-msg--${role === 'user' ? 'user' : 'oracle'}${isSecurityWarning ? ' security-warning' : ''}`;
      
      const name = document.createElement('div');
      name.className = 'bot-msg__name';
      name.textContent = role === 'user' ? 'You' : 'Oracle';
      
      const body = document.createElement('div');
      body.textContent = content;
      body.style.whiteSpace = 'pre-wrap';
      
      div.appendChild(name);
      div.appendChild(body);
      return div;
    }

    // Add message to conversation with smooth scrolling that respects motion preferences
    function addMessage(role, content, isSecurityWarning = false) {
      conversation.push({ role, content });
      const msgEl = createMessage(role, content, isSecurityWarning);
      messages.appendChild(msgEl);
      
      // Respect prefers-reduced-motion while keeping the latest message in view
      if (typeof msgEl.scrollIntoView === 'function') {
        const behavior = prefersReducedMotion() ? 'auto' : 'smooth';
        msgEl.scrollIntoView({
          behavior,
          block: 'end',
        });
      } else {
        // Fallback for very old browsers
        messages.scrollTop = messages.scrollHeight;
      }
      
      if (role === 'assistant') {
        speakMessage(content);
      }
    }

    // Send message handler
    function sendMessage() {
      const text = input.value.trim();
      if (!text) return;

      input.value = '';
      addMessage('user', text);

      // Security check using shared utility
      const securityIssues = detectSecurityIssues(text);
      if (securityIssues.length > 0) {
        addMessage('assistant', getSecurityWarning(securityIssues), true);
        return;
      }

      // Handle commands
      if (text.toLowerCase() === '/report') {
        addMessage('assistant', `📋 REPORT SYSTEM\n\nTo report security issues, abuse, or suspicious activity:\n\n1. For site issues: Open a GitHub issue at ${GITHUB_REPO_URL}/issues\n2. For urgent security vulnerabilities: Contact the maintainers directly\n3. For on-chain issues: Document transaction hashes and wallet addresses involved\n\nThe Oracle thanks you for protecting the Matrix ecosystem.`);
        return;
      }

      if (text.toLowerCase() === '/help') {
        addMessage('assistant', '🔮 THE ORACLE\'S WISDOM\n\nCommands:\n• /report - Report security issues or abuse\n• /help - Show this help\n\nQuestions I can answer:\n• "What is MTX?" - Learn about the Matrix-Hub token\n• "Security tips" - Get security guidance\n• "About casino" - Learn about Matrix casino\n• "Wallet" - Wallet connection info\n\nThe Oracle sees all paths. Choose wisely.');
        return;
      }

      // Generate response using shared utility
      const response = generateOracleResponse(text);
      setTimeout(() => {
        addMessage('assistant', response);
      }, 800 + Math.random() * 400);
    }

    // Event listeners
    botBtn.onclick = () => {
      const isOpen = botWin.style.display === 'flex';
      botWin.style.display = isOpen ? 'none' : 'flex';
      
      if (!isOpen && conversation.length === 0) {
        addMessage('assistant', 'The door is already open.\n\nI am the Oracle. I see the code, the patterns, the paths. Ask me about Matrix-Hub, MTX tokens, security, or the tools at your disposal.\n\nTry: "what is MTX", "security tips", "/report", or "/help".');
      }
      
      if (!isOpen) {
        setTimeout(() => input?.focus(), 100);
      }
    };

    closeBtn.onclick = () => {
      botWin.style.display = 'none';
    };

    appsBtn.onclick = () => {
      const isHidden = appsPanel?.hasAttribute('hidden');
      if (isHidden) {
        appsPanel?.removeAttribute('hidden');
        appsBtn?.setAttribute('aria-expanded', 'true');
      } else {
        appsPanel?.setAttribute('hidden', '');
        appsBtn?.setAttribute('aria-expanded', 'false');
      }
    };

    voiceBtn.onclick = () => {
      voiceEnabled = !voiceEnabled;
      voiceBtn.setAttribute('aria-pressed', voiceEnabled ? 'true' : 'false');
      
      const toastContainer = document.getElementById('oracleMatrixToasts');
      if (toastContainer) {
        const toast = document.createElement('div');
        toast.className = 'oracle-toast';
        toast.innerHTML = `
          <div class="oracle-toast__title">VOICE ${voiceEnabled ? 'ENABLED' : 'DISABLED'}</div>
          <div class="oracle-toast__body">${voiceEnabled ? 'The Oracle will speak.' : 'The Oracle is silent.'}</div>
        `;
        toastContainer.appendChild(toast);
        
        // Use CSS class for exit animation instead of inline styles
        setTimeout(() => {
          toast.classList.add('oracle-toast--removing');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }
    };

    sendBtn.onclick = sendMessage;
    
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') sendMessage();
    });
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOracleBot);
  } else {
    initOracleBot();
  }
</script>
