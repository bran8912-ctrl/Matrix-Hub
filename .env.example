# Environment variables for Matrix Hub deployment

# ⚠️ GITHUB ACTIONS DEPLOYMENT NOTICE
# For GitHub Actions workflows, all sensitive values MUST be configured as repository secrets.
# Go to: Repository Settings → Secrets and variables → Actions → Repository secrets
# Add each variable below as a separate secret with the same name.
# 
# GitHub Actions will automatically inject these values using the format:
# VARIABLE_NAME=${{ secrets.VARIABLE_NAME }}
#
# For local development, copy this file to .env and replace the secret references
# with actual values. NEVER commit the .env file with real values!

# Private key for deployment (without 0x prefix)
# GitHub Actions Secret: MAINNET_PRIVATE_KEY or PRIVATE_KEY
# Get a burner wallet private key for deployment
# ⚠️ NEVER use your main wallet private key!
PRIVATE_KEY=${{ secrets.PRIVATE_KEY }}

# Ethereum RPC URLs
# GitHub Actions Secret: MAINNET_RPC_URL
# Default fallback: https://eth.llamarpc.com
MAINNET_RPC_URL=${{ secrets.MAINNET_RPC_URL }}

# GitHub Actions Secret: SEPOLIA_RPC_URL
# Default fallback: https://rpc.sepolia.org/
SEPOLIA_RPC_URL=${{ secrets.SEPOLIA_RPC_URL }}

# API Keys for contract verification
# GitHub Actions Secret: ETHERSCAN_API_KEY
# Get from: https://etherscan.io/myapikey
# Required for verifying contracts after deployment
# Same key works for both Mainnet and Sepolia
ETHERSCAN_API_KEY=${{ secrets.ETHERSCAN_API_KEY }}

# MTX Contract Address (set after deployment)
# GitHub Actions Secret: MTX_CONTRACT_ADDRESS
# Leave empty until contract is deployed to mainnet
MTX_CONTRACT_ADDRESS=${{ secrets.MTX_CONTRACT_ADDRESS }}

# Supabase (for backend features)
# GitHub Actions Secret: SUPABASE_DATABASE_URL
# Get from: https://supabase.com/dashboard
SUPABASE_DATABASE_URL=${{ secrets.SUPABASE_DATABASE_URL }}

# GitHub Actions Secret: SUPABASE_ANON_KEY
# Get from: https://supabase.com/dashboard
SUPABASE_ANON_KEY=${{ secrets.SUPABASE_ANON_KEY }}

# Owners Portal Password Hash
# GitHub Actions Secret: OWNERS_PASSWORD_HASH
# Generate a SHA-256 hash of your password using the generate-password-hash.js script
# This script is the canonical way to create a valid password hash for Matrix Hub
# The resulting value will already include the required 'sha256-' prefix
# Run: node scripts/generate-password-hash.js "your-secure-password"
# ⚠️ IMPORTANT: Use a strong, unique password!
OWNERS_PASSWORD_HASH=${{ secrets.OWNERS_PASSWORD_HASH }}
