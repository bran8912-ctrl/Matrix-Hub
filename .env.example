# Environment variables for Matrix Hub deployment

# ⚠️ GITHUB ACTIONS DEPLOYMENT NOTICE
# For GitHub Actions workflows, configure these as repository secrets:
# - Go to: Repository Settings → Secrets and variables → Actions → Repository secrets
# - For mainnet deployments: Add MAINNET_PRIVATE_KEY, MAINNET_RPC_URL, ETHERSCAN_API_KEY
# - For testnet deployments: Add TESTNET_PRIVATE_KEY, SEPOLIA_RPC_URL, ETHERSCAN_API_KEY
# - For application: Add SUPABASE_DATABASE_URL, SUPABASE_ANON_KEY, OWNERS_PASSWORD_HASH
# - See docs/GITHUB_ACTIONS_SECRETS.md for complete guide
#
# For local development:
# - Copy this file to .env: cp .env.example .env
# - Replace placeholder values below with actual values
# - NEVER commit the .env file with real values!

# Private key for deployment (without 0x prefix)
# Local: Use actual private key value here
# GitHub Actions: Configure as MAINNET_PRIVATE_KEY or TESTNET_PRIVATE_KEY secret
#   (workflows automatically map these to PRIVATE_KEY environment variable)
# Get a burner wallet private key for deployment
# ⚠️ NEVER use your main wallet private key!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Ethereum RPC URLs
# Local: Use actual RPC URL or leave default
# GitHub Actions: Configure as MAINNET_RPC_URL or SEPOLIA_RPC_URL secret
MAINNET_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org/

# API Keys for contract verification
# Get from: https://etherscan.io/myapikey
# Required for verifying contracts after deployment
# Same key works for both Mainnet and Sepolia
# Local: Add your actual API key
# GitHub Actions: Configure as ETHERSCAN_API_KEY secret
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# MTX Contract Address (set after deployment)
# Leave empty until contract is deployed to mainnet
# Local: Add deployed contract address after deployment
# GitHub Actions: Configure as MTX_CONTRACT_ADDRESS secret
MTX_CONTRACT_ADDRESS=

# Supabase (for backend features)
# Get from: https://supabase.com/dashboard
# Local: Add your actual Supabase project credentials
# GitHub Actions: Configure as SUPABASE_DATABASE_URL and SUPABASE_ANON_KEY secrets
SUPABASE_DATABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Owners Portal Password Hash
# Generate a SHA-256 hash of your password using the generate-password-hash.js script
# This script is the canonical way to create a valid password hash for Matrix Hub
# The resulting value will already include the required 'sha256-' prefix
# Run: node scripts/generate-password-hash.js "your-secure-password"
# ⚠️ IMPORTANT: Use a strong, unique password!
# Local: Add the generated hash
# GitHub Actions: Configure as OWNERS_PASSWORD_HASH secret
OWNERS_PASSWORD_HASH=sha256-your_password_hash_here

# WalletConnect Project ID (for Reown AppKit / Web3Modal v3)
# Get from: https://cloud.reown.com (create a free project)
# Required for wallet connection functionality
# Local: Add your actual project ID
# GitHub Actions: Configure as PUBLIC_WALLETCONNECT_PROJECT_ID secret
PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
